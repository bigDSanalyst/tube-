        "session": {"tab_id": session.tab_id, "display_str": session.display_str,
                    "component_type": session.component_type,
                    "cloned_scrollback_lines": session.cloned_scrollback_lines},
    }


@app.post("/api/tabs/{tab_id}/close")
async def close_tab(tab_id: str,
                    requested_by: Optional[str] = Query(default=None),
                    x_v2e_cap_token: Optional[str] = Header(default=None),
                    token: Optional[str] = Query(default=None)):
    """Beacon call: token in query (sendBeacon can't set headers). Normal call: header."""
    eff = x_v2e_cap_token or token
    cap = engine.resolve_cap_token(eff)
    return await engine.close_and_reap_tab(
        tab_id, requested_by=requested_by, requesting_user=cap.user_id,
    )


@app.post("/api/pointer")
async def handle_pointer(req: PointerEventRequest,
                         cap: CapabilityToken = Depends(get_cap_token_from_header)):
    return await engine.route_pointer(req, cap)


@app.post("/api/keyboard")
async def handle_keyboard(req: KeyEventRequest,
                          cap: CapabilityToken = Depends(get_cap_token_from_header)):
    return engine.send_keystrokes(req.key_text, cap, req.target_display)


@app.post("/api/resync")
async def handle_resync(req: ResyncRequest,
                        cap: CapabilityToken = Depends(get_cap_token_from_header)):
