@app.get("/api/ledger")
def get_ledger(claims: Optional[SubscriberClaims] = Depends(verify_subscriber_optional)):
    cap_token = None
    can_popout = False
    reason: Optional[str] = None
    ws = None

    if claims is None:
        reason = "Sign in with a paid subscription to unlock pop-outs"
    elif TIER_RANK[claims.tier] < TIER_RANK[engine.manifest.min_subscriber_tier]:
        reason = f"Requires tier '{engine.manifest.min_subscriber_tier}'"
    elif "popout" not in claims.scope:
        reason = "Token scope missing 'popout'"
    elif not engine.manifest.allow_multi_tab_popout:
        reason = "Publisher disabled pop-outs for this video"
    else:
        cap_token = engine.issue_capability_token(claims)
        can_popout = True
        ws = engine.workspaces.get(claims.user_id)

    user_tabs = [
        asdict(t) for t in engine.active_tabs.values()
        if claims and t.owner_user_id == claims.user_id
    ]

    return {
        "capability_token": cap_token,
        "subscriber": {"user_id": claims.user_id, "tier": claims.tier} if claims else None,
        "can_popout": can_popout,
        "popout_disabled_reason": reason,
        "manifest": asdict(engine.manifest),
        "speaker_roi": engine.speaker_roi,
        "workspace_roi": engine.workspace_roi,
        "sub_components": [asdict(c) for c in engine.sub_components.values()],
        "active_tabs": user_tabs,
        "workspace_forked": bool(ws and ws.workspace_forked),
        "fork_display": ws.fork_display if ws else None,
        "nodes": [asdict(n) for n in engine.ledger],
    }


@app.get("/api/ledger/stream")
async def stream_ledger_events(claims: Optional[SubscriberClaims] = Depends(verify_subscriber_optional)):
    q: asyncio.Queue = asyncio.Queue(maxsize=16)
    user_id = claims.user_id if claims else None
    engine.sse_subscribers[q] = user_id

    async def gen():
        try:
            while True:
                try:
                    data = await asyncio.wait_for(q.get(), timeout=15.0)
                    yield f"data: {data}\n\n"
                except asyncio.TimeoutError:
                    yield ": keepalive\n\n"
        except asyncio.CancelledError:
            pass
        finally:
            engine.sse_subscribers.pop(q, None)

    return StreamingResponse(gen(), media_type="text/event-stream")


