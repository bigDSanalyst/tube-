async def verify_subscriber_optional(
    authorization: Optional[str] = Header(default=None),
) -> Optional[SubscriberClaims]:
    if not authorization or not authorization.startswith("Bearer "):
        return None
    if PUBLISHER_AUTH_PUBKEY is None:
        raise HTTPException(503, "Subscriber auth not configured")
    try:
        payload = jwt.decode(
            authorization[7:], PUBLISHER_AUTH_PUBKEY,
            algorithms=["EdDSA"], audience="v2e-engine",
            issuer="publisher-auth",
        )
    except PyJWTError:
        raise HTTPException(401, "Invalid or expired subscriber token")
    if payload.get("publisher_id") != engine.manifest.publisher_id:
        raise HTTPException(403, "Subscriber token is for a different publisher")
    return SubscriberClaims(
        user_id=payload["sub"], publisher_id=payload["publisher_id"],
        tier=payload.get("tier", "free"),
        scope=payload.get("scope", []), exp=payload["exp"],
    )


