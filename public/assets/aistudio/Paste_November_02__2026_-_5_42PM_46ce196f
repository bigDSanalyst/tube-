@app.get("/api/ledger")
def get_ledger(
    claims: Optional[SubscriberClaims] = Depends(verify_subscriber_optional),
    x_v2e_cap_token: Optional[str] = Header(default=None),
):
    cap_token = None
    can_popout = False
    reason: Optional[str] = None
    ws = None
    subscriber_info = None
    eff_user_id: Optional[str] = None

    if claims is not None:
        eff_user_id = claims.user_id
        subscriber_info = {"user_id": claims.user_id, "tier": claims.tier}
        if TIER_RANK[claims.tier] < TIER_RANK[engine.manifest.min_subscriber_tier]:
            reason = f"Requires tier '{engine.manifest.min_subscriber_tier}'"
        elif "popout" not in claims.scope:
            reason = "Token scope missing 'popout'"
        elif not engine.manifest.allow_multi_tab_popout:
            reason = "Publisher disabled pop-outs for this video"
        else:
            cap_token = engine.issue_capability_token(claims)
            can_popout = True
            ws = engine.workspaces.get(claims.user_id)
    elif x_v2e_cap_token and x_v2e_cap_token in engine.valid_cap_tokens:
        # Allows detached tabs and SSE manifest refreshes holding an active cap-token to stay authenticated
        cap_obj = engine.valid_cap_tokens[x_v2e_cap_token]
        eff_user_id = cap_obj.user_id
        cap_token = cap_obj.token
        subscriber_info = {"user_id": cap_obj.user_id, "tier": cap_obj.tier}
        can_popout = (
            TIER_RANK[cap_obj.tier] >= TIER_RANK[engine.manifest.min_subscriber_tier]
            and bool(engine.manifest.allow_multi_tab_popout)
        )
        if not can_popout:
            reason = "Pop-outs restricted by publisher manifest"
        ws = engine.workspaces.get(cap_obj.user_id)
    else:
        reason = "Sign in with a paid subscription to unlock pop-outs"

    user_tabs = [
        {
            "tab_id": t.tab_id,
            "component_type": t.component_type,
            "display_str": t.display_str,
            "cloned_scrollback_lines": t.cloned_scrollback_lines,
        }
        for t in engine.active_tabs.values()
        if eff_user_id and t.owner_user_id == eff_user_id
    ]

    return {
        "capability_token": cap_token,
        "subscriber": subscriber_info,
        "can_popout": can_popout,
        "popout_disabled_reason": reason,
        "manifest": asdict(engine.manifest),
        "speaker_roi": engine.speaker_roi,
        "workspace_roi": engine.workspace_roi,
        "sub_components": [asdict(c) for c in engine.sub_components.values()],
        "active_tabs": user_tabs,
        "workspace_forked": bool(ws and ws.workspace_forked),
        "fork_display": ws.fork_display if ws else None,
        "nodes": [asdict(n) for n in engine.ledger],
    }


@app.get("/api/ledger/stream")
async def stream_ledger_events(
    ticket: Optional[str] = Query(default=None),
    claims: Optional[SubscriberClaims] = Depends(verify_subscriber_optional),
):
    user_id = claims.user_id if claims else None
    if not user_id and ticket:
        entry = engine.ws_tickets.pop(ticket, None)
        if entry:
            user_id = entry["user_id"]

    q: asyncio.Queue = asyncio.Queue(maxsize=16)
    engine.sse_subscribers[q] = user_id

    async def gen():
        try:
            while True:
                try:
                    data = await asyncio.wait_for(q.get(), timeout=15.0)
                    yield f"data: {data}\n\n"
                except asyncio.TimeoutError:
                    yield ": keepalive\n\n"
        except asyncio.CancelledError:
            pass
        finally:
            engine.sse_subscribers.pop(q, None)

    return StreamingResponse(gen(), media_type="text/event-stream")


