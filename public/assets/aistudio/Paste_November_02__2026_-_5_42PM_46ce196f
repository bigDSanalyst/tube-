  // -------------------------------------------------------------------
  // UI wiring
  // -------------------------------------------------------------------
  function wireUI() {
    for (const btn of document.querySelectorAll('.popout-btn')) {
      btn.addEventListener('click', () => spawnTab(btn.dataset.component));
    }

    const canvas = $('subscreenCanvas');
    if (canvas) {
      canvas.addEventListener('click', (e) => {
        const r = canvas.getBoundingClientRect();
        const normX = (e.clientX - r.left) / Math.max(r.width, 1);
        const normY = (e.clientY - r.top) / Math.max(r.height, 1);

        if (state.detachedTabId) {
          // Detached tab: map [0..1] across full 1280x720 payload and specify target_display
          sendPointer(Math.round(normX * 1280), Math.round(normY * 720), state.detachedDisplay);
        } else {
          // Main tab: #subscreenCanvas covers the workspace ROI (40, 40, 920, 600) inside 1280x720
          const px = Math.round(40 + normX * 920);
          const py = Math.round(40 + normY * 600);
          sendPointer(px, py, null);
        }
      });
