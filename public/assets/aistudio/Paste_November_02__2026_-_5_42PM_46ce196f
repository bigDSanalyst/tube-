(function () {
  'use strict';

  // -------------------------------------------------------------------
  // State
  // -------------------------------------------------------------------
  const state = {
    capToken: null,
    canPopout: false,
    subscriber: null,
    manifest: null,
    ledger: [],
    activeTabs: [],
    workspaceForked: false,
    speakerPlaying: true,
    forkDisplay: null,
    detachedTabId: null,
    detachedDisplay: null,
    detachedComponent: null,
    detachedMs: 0,
    wsConn: null,
    sseConn: null,
    lastSpeakerMs: 0,
    bootstrapped: false,
  };

  const pathMatch = location.pathname.match(/^\/tab\/([^/]+)$/);
  if (pathMatch) {
    state.detachedTabId = decodeURIComponent(pathMatch[1]);
    const qs = new URLSearchParams(location.search);
    state.detachedDisplay = qs.get('display');
    state.detachedComponent = qs.get('component');
    state.detachedMs = parseInt(qs.get('ms') || '0', 10) || 0;
