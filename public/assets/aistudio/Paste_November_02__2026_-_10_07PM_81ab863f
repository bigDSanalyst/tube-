            return
        for tab in self.active_tabs.values():
            if tab.display_str == disp:
                if user_id is None or tab.owner_user_id != user_id:
                    raise HTTPException(403, "Sandbox belongs to another subscriber")
                return
        for ws in self.workspaces.values():
