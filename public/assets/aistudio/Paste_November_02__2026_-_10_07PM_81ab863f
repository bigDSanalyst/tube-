    if (state.detachedTabId) return state.lastSpeakerMs || 0;
    const v = $('vid');
    return v ? Math.floor(v.currentTime * 1000) : 0;
  }

  function apiHeaders(extra) {
    const h = Object.assign({}, extra || {});
    if (state.capToken) h['X-V2E-Cap-Token'] = state.capToken;
    return h;
  }

  async function fetchOneTimeTicket() {
    const res = await fetch('/api/ws-ticket', {
      method: 'POST',
      headers: apiHeaders({}),
    });
    if (!res.ok) throw new Error('ticket ' + res.status);
    const j = await res.json();
    return j.ticket;
  }

  // -------------------------------------------------------------------
  // Bootstrap
  // -------------------------------------------------------------------
  async function bootstrap() {
    try {
      const cached = localStorage.getItem('v2e_cap_token');
      if (cached && !state.capToken) state.capToken = cached;
    } catch (_) {}

    if (state.detachedTabId && state.capToken) {
      fetch('/api/tabs/' + encodeURIComponent(state.detachedTabId) + '/touch', {
        method: 'POST',
        headers: apiHeaders({}),
      }).catch(() => {});
    }

    try {
      const res = await fetch('/api/ledger', { headers: apiHeaders({}) });
      if (!res.ok) throw new Error('ledger ' + res.status);
      const data = await res.json();
      state.capToken = data.capability_token || state.capToken;
      state.canPopout = !!data.can_popout;
      state.subscriber = data.subscriber;
      state.manifest = data.manifest;
      state.ledger = data.nodes || [];
      state.activeTabs = data.active_tabs || [];
      state.workspaceForked = !!data.workspace_forked;
      state.forkDisplay = data.fork_display || null;
    } catch (e) {
      toast('Failed to load engine state: ' + e.message);
      console.error(e);
    }

    if (!state.detachedTabId) {
      try {
        if (state.capToken) localStorage.setItem('v2e_cap_token', state.capToken);
        else localStorage.removeItem('v2e_cap_token');
      } catch (_) {}

      const v = $('vid');
      if (v) v.src = '/api/video';
    }

    applyLedger();
    applySubscriberBadge();
    applyPopoutState();
    applyWorkspaceState();
    wireUI();
    setupBroadcastChannel();
    await connectSSE();
    await connectSubscreenWS();
    state.bootstrapped = true;
  }

  // -------------------------------------------------------------------
  // Renderers
  // -------------------------------------------------------------------
  function applyLedger() {
    const list = $('ledgerList');
    if (!list) return;
    const frag = document.createDocumentFragment();
    for (const n of state.ledger) {
      const div = document.createElement('div');
      div.className = 'ledger-node';
      div.innerHTML =
        '<div class="ts">t=' + n.timestamp_ms + 'ms  #' + n.node_id + '</div>' +
        '<div>' + escapeHtml(n.spoken_text) + '</div>' +
        '<div class="cmd">$ ' + escapeHtml(n.inferred_cmd) + '</div>';
      frag.appendChild(div);
    }
    list.innerHTML = '';
    list.appendChild(frag);
    const mi = $('manifestInfo');
    if (mi && state.manifest) {
      mi.textContent = 'video=' + state.manifest.video_id +
        ' · tier=' + state.manifest.min_subscriber_tier;
    }
  }

  function applySubscriberBadge() {
    const badge = $('subBadge');
    if (!badge) return;
    if (state.subscriber) {
      badge.textContent = state.subscriber.tier.toUpperCase() + ' · ' + state.subscriber.user_id;
      badge.classList.remove('sub-locked');
    } else {
      badge.textContent = 'FREE VIEWER';
      badge.classList.add('sub-locked');
    }
  }

  function applyPopoutState() {
    const reason = state.canPopout ? '' : 'Subscribe for pop-outs';
    for (const btn of document.querySelectorAll('.popout-btn')) {
      btn.disabled = !state.canPopout;
      btn.title = reason;
    }
  }

  function applyWorkspaceState() {
    const f = $('forkStatus'), s = $('speakerStatus'), t = $('tabCount');
    if (f) f.textContent = state.workspaceForked
      ? 'Workspace: forked ' + (state.forkDisplay || '')
      : 'Workspace: shared trunk';
    if (s) s.textContent = state.speakerPlaying ? 'Speaker: playing' : 'Speaker: paused';
    if (t) t.textContent = 'Tabs: ' + state.activeTabs.length;

    const canvas = $('subscreenCanvas');
    if (canvas) {
      canvas.classList.toggle('forked', state.workspaceForked);
      canvas.classList.toggle('detached', !!state.detachedTabId);
    }

    const wsCanvas = $('wsCanvas');
    if (wsCanvas) {
      wsCanvas.classList.toggle('forked', state.workspaceForked);
    }

    const v = $('vid');
    if (v && !state.detachedTabId) {
      if (state.speakerPlaying && v.paused) v.play().catch(() => {});
      else if (!state.speakerPlaying && !v.paused) v.pause();
    }
  }

  // -------------------------------------------------------------------
  // UI wiring
  // -------------------------------------------------------------------
  function wireUI() {
    for (const btn of document.querySelectorAll('.popout-btn')) {
      btn.addEventListener('click', () => spawnTab(btn.dataset.component));
    }

    const canvas = $('subscreenCanvas');
    if (canvas) {
      canvas.addEventListener('click', (e) => {
        const r = canvas.getBoundingClientRect();
        const normX = (e.clientX - r.left) / Math.max(r.width, 1);
        const normY = (e.clientY - r.top) / Math.max(r.height, 1);

        if (state.detachedTabId) {
          sendPointer(Math.round(normX * 1280), Math.round(normY * 720), state.detachedDisplay);
        } else {
          const px = Math.round(40 + normX * 920);
          const py = Math.round(40 + normY * 600);
          sendPointer(px, py, null);
        }
      });
    }

    const sp = $('speakerHitbox');
    if (sp) {
      sp.addEventListener('click', () => sendPointer(1100, 580, null));
    }

    window.addEventListener('keydown', handleKeydown, { capture: true });
  }

  // -------------------------------------------------------------------
  // Keyboard bridge
  // -------------------------------------------------------------------
  const kbuf = { text: '' };
  function handleKeydown(e) {
    const activeTarget = state.detachedTabId
      ? state.detachedDisplay
      : (state.workspaceForked ? state.forkDisplay : null);
    if (!activeTarget) return;
    if (!state.capToken) { toast('Sign in to type'); return; }

    if (e.key === 'Enter') {
      e.preventDefault();
      const cmd = kbuf.text.trim();
      kbuf.text = '';
      if (!cmd) return;
      fetch('/api/keyboard', {
        method: 'POST',
        headers: apiHeaders({ 'Content-Type': 'application/json' }),
        body: JSON.stringify({
          key_text: cmd,
          target_display: activeTarget,
        }),
      }).catch((err) => toast('keystroke failed: ' + err.message));
      return;
    }

    if (e.key === 'Backspace') { e.preventDefault(); kbuf.text = kbuf.text.slice(0, -1); return; }
    if (e.key === 'Escape') { kbuf.text = ''; return; }
    if (e.key.length === 1 && !e.ctrlKey && !e.metaKey && !e.altKey) {
      e.preventDefault();
      kbuf.text += e.key;
    }
  }

  // -------------------------------------------------------------------
  // Pointer
  // -------------------------------------------------------------------
  async function sendPointer(px, py, targetDisplay) {
    if (!state.capToken) { toast('Subscribe to interact'); return; }
    try {
      const payload = {
        px: px, py: py,
        video_width: 1280, video_height: 720,
        current_speaker_ms: getSpeakerMs(),
      };
      if (targetDisplay) payload.target_display = targetDisplay;

      const res = await fetch('/api/pointer', {
        method: 'POST',
        headers: apiHeaders({ 'Content-Type': 'application/json' }),
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (data.hit_target === 'RESTRICTED') {
        toast(data.message || 'Restricted');
        return;
      }
      const prevFork = state.forkDisplay;
      if (typeof data.speaker_playing === 'boolean') state.speakerPlaying = data.speaker_playing;
      if (typeof data.workspace_forked === 'boolean') state.workspaceForked = data.workspace_forked;
      if (data.fork_display && !state.detachedTabId) state.forkDisplay = data.fork_display;
      applyWorkspaceState();

      if (data.hit_target === 'WORKSPACE_SUBSCREEN' && data.fork_display && data.fork_display !== prevFork) {
        connectSubscreenWS();
      }
    } catch (e) {
      toast('pointer failed: ' + e.message);
    }
  }

  // -------------------------------------------------------------------
  // Pop-out
  // -------------------------------------------------------------------
  async function spawnTab(component) {
    if (!state.canPopout || !state.capToken) { toast('Pop-outs require a paid subscription'); return; }
    try {
      const res = await fetch('/api/tabs/spawn', {
        method: 'POST',
        headers: apiHeaders({ 'Content-Type': 'application/json' }),
        body: JSON.stringify({
          component_type: component,
          replay_from_ms: getSpeakerMs(),
          clone_live_fork_state: true,
        }),
      });
      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        toast(err.detail || ('spawn failed ' + res.status));
        return;
      }
      const data = await res.json();
      window.open(data.tab_url, '_blank', 'noopener');
    } catch (e) {
      toast('spawn failed: ' + e.message);
    }
  }

  // -------------------------------------------------------------------
  // Ticket-authenticated SSE (with P2 exponential backoff)
  // -------------------------------------------------------------------
  async function connectSSE() {
    if (state.sseConn) {
      try { state.sseConn.close(); } catch (_) {}
      state.sseConn = null;
    }

    let url = '/api/ledger/stream';
    if (state.capToken) {
      try {
        const ticket = await fetchOneTimeTicket();
        url += '?ticket=' + encodeURIComponent(ticket);
      } catch (e) {
        console.warn('[v2e] SSE ticket exchange failed, falling back to anonymous SSE', e);
      }
    }

    const es = new EventSource(url);
    state.sseConn = es;

    es.onopen = () => {
      state.sseRetryCount = 0;
    };

    es.onmessage = (ev) => {
      state.sseRetryCount = 0;
      if (!ev.data || ev.data[0] === ':') return;
      let d;
      try { d = JSON.parse(ev.data); } catch (_) { return; }

      const manifestChanged = d.manifest && JSON.stringify(d.manifest) !== JSON.stringify(state.manifest);
      if (d.manifest) state.manifest = d.manifest;
      if (Array.isArray(d.active_tabs)) state.activeTabs = d.active_tabs;
      if (typeof d.workspace_forked === 'boolean') state.workspaceForked = d.workspace_forked;
      if (typeof d.speaker_playing === 'boolean') state.speakerPlaying = d.speaker_playing;
      if (d.fork_display !== undefined) state.forkDisplay = d.fork_display;
      applyWorkspaceState();

      if (manifestChanged) refreshAuthState();
    };

    es.onerror = () => {
      try { es.close(); } catch (_) {}
      state.sseConn = null;
      if (!document.hidden && state.bootstrapped) {
        const delay = Math.min(30000, 1000 * Math.pow(2, state.sseRetryCount));
        state.sseRetryCount = Math.min(state.sseRetryCount + 1, 6);
        setTimeout(() => connectSSE(), delay);
      }
    };
  }

  async function refreshAuthState() {
    try {
      const res = await fetch('/api/ledger', { headers: apiHeaders({}) });
      const data = await res.json();
      if (data.capability_token) {
        state.capToken = data.capability_token;
        if (!state.detachedTabId) {
          try { localStorage.setItem('v2e_cap_token', state.capToken); } catch (_) {}
        }
      }
      state.canPopout = !!data.can_popout;
      applyPopoutState();
      applySubscriberBadge();
    } catch (_) {}
  }

  // -------------------------------------------------------------------
  // Subscreen WS stream — via one-use ticket
  // -------------------------------------------------------------------
  async function connectSubscreenWS() {
    let target = null;
    if (state.detachedTabId) {
      target = state.detachedDisplay || state.forkDisplay || null;
    } else if (state.workspaceForked && state.forkDisplay) {
      target = state.forkDisplay;
    }

    let ticket;
    try {
      ticket = await fetchOneTimeTicket();
    } catch (e) {
      console.warn('[v2e] ws-ticket failed', e);
      return;
    }

    const proto = location.protocol === 'https:' ? 'wss:' : 'ws:';
    const qs = new URLSearchParams({ ticket: ticket });
    if (target) qs.set('display', target);
    const url = proto + '//' + location.host + '/ws/subscreen?' + qs;

    if (state.wsConn) {
      try { state.wsConn.close(); } catch (_) {}
    }
    const ws = new WebSocket(url);
    ws.binaryType = 'arraybuffer';
    state.wsConn = ws;

    const wsCanvas = $('wsCanvas');
    const ctx = wsCanvas ? wsCanvas.getContext('2d') : null;

    ws.onopen = () => {
      if (wsCanvas) {
        wsCanvas.width = 1024;
        wsCanvas.height = 768;
      }
    };

    ws.onmessage = async (ev) => {
      if (!ctx || !ev.data) return;
      try {
        const blob = new Blob([ev.data], { type: 'image/jpeg' });
        const bmp = await createImageBitmap(blob);
        ctx.drawImage(bmp, 0, 0, wsCanvas.width, wsCanvas.height);
        if (bmp.close) bmp.close();
      } catch (_) {}
      try { ws.send('ack'); } catch (_) {}
    };

    ws.onerror = () => {};

    ws.onclose = (ev) => {
      state.wsConn = null;
      if (ev && ev.code === 1008) {
        toast('Subscreen access denied');
        return;
      }
      if (!document.hidden && state.bootstrapped) {
        setTimeout(() => connectSubscreenWS(), 2000);
      }
    };
  }

  // -------------------------------------------------------------------
  // Synchronous beacon on pagehide + revival via /touch on reload
  // -------------------------------------------------------------------
  window.addEventListener('pagehide', (event) => {
    if (event.persisted) return;
    if (!state.detachedTabId || !state.capToken) return;
    const url = '/api/tabs/' +
      encodeURIComponent(state.detachedTabId) +
      '/close?requested_by=beacon&token=' +
      encodeURIComponent(state.capToken);
    try { navigator.sendBeacon(url); } catch (_) {}
  });

  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState !== 'visible') return;
    if (!state.bootstrapped) return;
    if (!state.wsConn || state.wsConn.readyState > 1) {
      connectSubscreenWS();
    }
    if (!state.sseConn || state.sseConn.readyState === 2) {
      state.sseRetryCount = 0;
      connectSSE();
    }
    refreshAuthState();
  });

  // -------------------------------------------------------------------
  // BroadcastChannel — live speaker timestamp heartbeat
  // -------------------------------------------------------------------
  function setupBroadcastChannel() {
    if (typeof BroadcastChannel === 'undefined') return;
    if (!state.detachedTabId) {
      const bc = new BroadcastChannel('v2e_speaker');
      setInterval(() => {
        try {
          bc.postMessage({ speakerMs: getSpeakerMs(), ts: Date.now() });
        } catch (_) {}
      }, 500);
    } else {
      const bc = new BroadcastChannel('v2e_speaker');
      bc.onmessage = (ev) => {
        if (ev.data && typeof ev.data.speakerMs === 'number') {
          state.lastSpeakerMs = ev.data.speakerMs;
        }
      };
    }
  }

  // -------------------------------------------------------------------
  // Go
  // -------------------------------------------------------------------
  bootstrap();
})();
</script>
</body>
</html>

